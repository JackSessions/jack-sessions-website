---
import HeaderLink from './HeaderLink.astro';
import { NAV, SOCIALS } from '../consts';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">jack<span class="dot">.</span>sessions</a>

    <nav class="nav" aria-label="Primary">
      {NAV.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
    </nav>

    <div class="socials">
      {SOCIALS.github && (
        <a href={SOCIALS.github} aria-label="GitHub" target="_blank" rel="me noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.3-1.8-1.3-1.8-1.1-.7 0-.7 0-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.4-1.3-5.4-5.9 0-1.3.5-2.4 1.2-3.2 0-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 5 18 5.3 18 5.3c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.8 1 .8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/></svg>
        </a>
      )}
      {SOCIALS.youtube && (
        <a href={SOCIALS.youtube} aria-label="YouTube" target="_blank" rel="me noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/></svg>
        </a>
      )}
      <button class="fx-toggle" type="button" data-fx-toggle aria-label="Toggle colour effects" title="Colour effects on/off" aria-pressed="true">
        <svg width="22" height="22" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path class="bulb-fill" d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-fx-toggle]')!;
  const root = document.documentElement;
  const sync = () => btn.setAttribute('aria-pressed', String(root.dataset.fx !== 'mono'));
  sync();
  btn.addEventListener('click', () => {
    const mono = root.dataset.fx !== 'mono';
    if (mono) root.dataset.fx = 'mono'; else delete root.dataset.fx;
    try { mono ? localStorage.setItem('fx', 'mono') : localStorage.removeItem('fx'); } catch {}
    sync();
  });
</script>
