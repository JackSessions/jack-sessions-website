---
import { SOCIALS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap bar">
    <span>© {year} Jack Sessions · built with Astro on Cloudflare</span>
    <span>
      {SOCIALS.email && <a href={SOCIALS.email}>email</a>}
      {SOCIALS.github && <> · <a href={SOCIALS.github} target="_blank" rel="noopener">github</a></>}
      {SOCIALS.youtube && <> · <a href={SOCIALS.youtube} target="_blank" rel="noopener">youtube</a></>}
    </span>
  </div>
</footer>
