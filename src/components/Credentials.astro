---
/* Credentials strip: the proof recruiters scan for, directly under the hero. */
import { SOCIALS } from '../consts';
const CERTS = [
  { name: 'GCFA', note: 'GIAC Certified Forensic Analyst', badge: '/giac-certified-forensic-analyst-gcfa.png' },
  { name: 'BTL1', note: 'Blue Team Level 1', badge: '/btl1.png' },
  { name: 'Security+', note: 'CompTIA Security+', badge: '/security-plus.png' },
];
const CVES = ['CVE-2025-50861', 'CVE-2025-50862'];
---

<section class="section creds" aria-label="Credentials">
  <div class="wrap">
    <div class="section-head">
      <h2>Credentials</h2><span class="rule"></span>
      <a class="count" href={SOCIALS.credly} target="_blank" rel="noopener">verify on Credly →</a>
    </div>

    <ul class="creds__row">
      {CERTS.map((c) => (
        <li class="cert" title={c.note}>
          <img src={c.badge} alt={`${c.name}: ${c.note}`} width="140" height="140" />
        </li>
      ))}
    </ul>

    <p class="creds__cve">
      <span class="muted">Recognition</span>
      {CVES.map((id) => (
        <a class="tag" href={`https://nvd.nist.gov/vuln/detail/${id}`} target="_blank" rel="noopener">{id}</a>
      ))}
    </p>
  </div>
</section>

<style>
  .creds { padding-bottom: 0; }
  .creds__row { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: space-evenly; gap: 1.5rem; }
  .cert { display: flex; flex: 1 1 0; justify-content: center; min-width: 140px; }
  .cert img { width: 140px; height: 140px; object-fit: contain; }
  .creds__cve { max-width: none; margin-top: 2.75rem; display: flex; gap: 0.6rem; align-items: center; justify-content: center; flex-wrap: wrap; }
</style>
