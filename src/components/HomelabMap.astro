  :global(.lab__labels) { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  :global(.lab-label) { font-family: var(--font-mono); font-size: 0.74rem; color: #e8f6ff; background: rgba(5, 12, 16, .78); border: 1px solid rgba(255, 176, 46, .5); padding: 0.1rem 0.45rem; border-radius: 3px; white-space: nowrap; transform: translateY(-4px); text-transform: uppercase; letter-spacing: .03em; }
  :global(.lab-label.zone) { font-size: 0.62rem; color: #7fa7b5; border-color: transparent; background: transparent; letter-spacing: .1em; }
  :global(.lab-label.zone.big) { font-size: 0.8rem; color: #cfe7f0; }
  :global(.lab-label.tiny) { font-size: 0.58rem; padding: 0 0.25rem; }
  :global(.lab-label.danger), :global(.lab-label.flag) { color: #ffd2d6; border-color: rgba(255, 77, 94, .85); }
  :global(.lab-label.flag::after) { content: ' ⚠'; color: #ffb02e; }
  :global(.lab-label.breach) { background: #ff4d5e; color: #fff; border-color: #fff; animation: blink .5s steps(2) infinite; }
  @keyframes blink { 50% { opacity: .55; } }
  .lab__fx { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, .65)), repeating-linear-gradient(0deg, rgba(255, 176, 46, .035) 0 1px, transparent 1px 3px); }
  .c { position: absolute; width: 26px; height: 26px; border: 2px solid rgba(255, 176, 46, .75); }
  .c.tl { top: 64px; left: 14px; border-right: 0; border-bottom: 0; } .c.tr { top: 64px; right: 14px; border-left: 0; border-bottom: 0; }
  .c.bl { bottom: 62px; left: 14px; border-right: 0; border-top: 0; } .c.br { bottom: 62px; right: 14px; border-left: 0; border-top: 0; }
  .lab__hud { position: absolute; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; flex-wrap: wrap; padding: 0.6rem 1rem; font-size: 0.74rem; color: var(--accent-2); background: linear-gradient(#05080a 60%, transparent); z-index: 3; letter-spacing: .06em; }
  .hud__left strong { letter-spacing: .14em; } .hud__left span { margin-left: 0.8rem; color: var(--muted); }
  .hud__maps { display: flex; gap: 0.3rem; flex-wrap: wrap; } .hud__maps.dim { opacity: .45; }
