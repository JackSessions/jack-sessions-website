---
/*
  Matrix rain for the hero. Two modes that swap every ~11s:
    1. powershell // dfir  — phosphor-green forensic one-liners, reading top to bottom.
    2. arm64 // reversing  — rainbow, lower opacity, ARM64 mnemonics, plus a smaller/dimmer
                             layer of Java/Kotlin (Android-side) snippets behind it.
  Faded out over the centre so the face stays clear. Static single frame for
  prefers-reduced-motion; paused when scrolled off-screen.
*/
---

<canvas class="rain" data-rain aria-hidden="true"></canvas>
<span class="rain__tag" data-rain-tag aria-hidden="true">powershell // dfir</span>

<script>
  const PS = [
    'Get-WinEvent -LogName Security', 'Get-Process | Sort CPU', 'Get-NetTCPConnection',
    'Get-FileHash -Algorithm SHA256', 'Get-ScheduledTask', 'Get-CimInstance Win32_Process',
    'Get-ChildItem -Recurse -Force', 'Get-Service | ? Running', 'Get-LocalUser',
    'wevtutil qe Security /c:50', 'Select-String -Pattern', 'Format-Hex .\\sample.bin',
    'Get-ItemProperty HKLM:\\...\\Run', 'Get-MpThreatDetection', 'Get-HotFix',
    'Get-WinEvent -FilterHashtable', 'Export-Csv timeline.csv', 'Get-PSDrive -PSProvider FileSystem',
  ];
  const ARM = [
    'stp x29, x30, [sp, #-32]!', 'ldr x0, [x29, #16]', 'bl 0x4005d0', 'mov x0, #0', 'svc #0',
    'ldp x29, x30, [sp], #32', 'ret', 'cbz x1, 0x40', 'adrp x8, #0x1000', 'blr x16',
    'eor w2, w2, w3', 'cmp x0, #0', 'b.ne 0x58', 'str w0, [sp, #12]', 'pacibsp', 'retaa',
    'ldr x1, [x0, #8]', 'add x29, sp, #0', 'sub sp, sp, #0x30', 'mov x8, #0xdd',
  ];
  const JK = [
    'System.loadLibrary("native")', 'fun onCreate()', 'invoke-virtual {v0}', 'Runtime.exec(cmd)',
    'override fun onReceive', 'JNIEnv* env', 'Cipher.getInstance("AES")', 'val intent = Intent()',
    'PackageManager.GET_SIGNATURES', '@JvmStatic external', 'Class.forName(name)', 'public native int',
  ];

  const canvas = document.querySelector<HTMLCanvasElement>('[data-rain]')!;
  const tag = document.querySelector<HTMLElement>('[data-rain-tag]')!;
  const ctx = canvas.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MODE_MS = 11000;
  const mono = () => document.documentElement.dataset.fx === 'mono';

  type Col = { x: number; text: string; off: number; head: number; speed: number; len: number; hue: number };
  type Layer = { fs: number; gap: number; pool: string[]; cols: Col[]; armOnly: boolean; alpha: [number, number] };

  // alpha = [powershell, arm64] — arm is deliberately quieter
  const layers: Layer[] = [
    { fs: 17, gap: 1.55, pool: [], cols: [], armOnly: false, alpha: [0.95, 0.6] },
    { fs: 11, gap: 2.1, pool: JK, cols: [], armOnly: true,  alpha: [0, 0.3] },
  ];

  let mode: 'ps' | 'arm' = 'ps';
  let modeStart = performance.now();
  let w = 0, h = 0, last = 0, raf = 0;
  const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#4af0a2';
  const [ar, ag, ab] = [1, 3, 5].map((i) => parseInt(accent.slice(i, i + 2), 16));

  const pick = (a: string[]) => a[Math.floor(Math.random() * a.length)];
  const rows = (l: Layer) => Math.ceil(h / (l.fs * 1.15));

  function respawn(l: Layer, c: Col, initial = false) {
    const pool = l.pool.length ? l.pool : mode === 'ps' ? PS : ARM;
    c.text = pick(pool);
    c.off = Math.floor(Math.random() * c.text.length);
    c.len = 10 + Math.floor(Math.random() * 18);
    c.speed = 7 + Math.random() * 12;           // rows / second
    c.head = initial ? Math.random() * rows(l) : -Math.random() * rows(l) * 0.6;
  }

  function seed(initial: boolean) {
    for (const l of layers) {
      const step = l.fs * l.gap;
      l.cols = [];
      for (let x = step / 2; x < w; x += step) {
        if (Math.random() < 0.12) continue;      // sparse
        const c: Col = { x, text: '', off: 0, head: 0, speed: 0, len: 0, hue: Math.random() * 360 };
        respawn(l, c, initial);
        l.cols.push(c);
      }
    }
  }

  function resize() {
    const r = canvas.getBoundingClientRect();
    const dpr = Math.min(devicePixelRatio || 1, 2);
    w = r.width; h = r.height;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    seed(true);
  }

  function setMode(m: 'ps' | 'arm') {
    mode = m;
    modeStart = performance.now();
    tag.textContent = m === 'ps' ? 'powershell // dfir' : 'arm64 // reversing';
    tag.dataset.mode = m;
    seed(false);                                 // new columns start above the fold
  }

  function draw(now: number) {
    ctx.clearRect(0, 0, w, h);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    const mi = mode === 'ps' ? 0 : 1;
    for (const l of layers) {
      if (l.armOnly && mode !== 'arm') continue;
      const rh = l.fs * 1.15, n = rows(l);
      ctx.font = `${l.fs}px "JetBrains Mono", ui-monospace, monospace`;
      for (const c of l.cols) {
        const hd = Math.floor(c.head);
        for (let k = 0; k < c.len; k++) {
          const row = hd - k;
          if (row < 0 || row >= n) continue;
          const fade = Math.pow(1 - k / c.len, 1.6);
          const a = l.alpha[mi] * fade;
          const ch = c.text[(row + c.off) % c.text.length];
          if (ch === ' ') continue;
          const head = k === 0;
          if (mode === 'ps') {
            // cyan -> green band, white-hot heads
            const hue = mono() ? 145 + (row % 3) * 3 : 130 + ((c.hue + row * 3) % 70);
            ctx.fillStyle = `hsla(${hue},100%,${head ? 92 : 60}%,${a})`;
            ctx.shadowColor = `hsla(${hue},100%,60%,1)`;
          } else {
            const hue = mono() ? 140 + (row % 4) * 4 : (c.hue + now / 25 + row * 9) % 360;   // full rainbow, drifting + banded down the column
            ctx.fillStyle = `hsla(${hue},100%,${head ? 90 : 62}%,${a})`;
            ctx.shadowColor = `hsla(${hue},100%,60%,1)`;
          }
          ctx.shadowBlur = head && l.fs > 12 ? 14 : 0;
          ctx.fillText(ch, c.x, row * rh);
        }
      }
    }
  }

  function tick(now: number) {
    const dt = Math.min((now - (last || now)) / 1000, 0.05);
    last = now;
    if (now - modeStart > MODE_MS) setMode(mode === 'ps' ? 'arm' : 'ps');
    for (const l of layers) {
      const n = rows(l);
      for (const c of l.cols) {
        c.head += c.speed * dt;
        if (c.head - c.len > n) respawn(l, c);
      }
    }
    draw(now);
    raf = requestAnimationFrame(tick);
  }

  resize();
  addEventListener('resize', resize);

  if (reduce) {
    draw(0);                                     // one still frame, no loop
  } else {
    new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      last = 0;
      if (e.isIntersecting) raf = requestAnimationFrame(tick);
    }).observe(canvas);
  }
</script>

<style>
  .rain {
    position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%;
    pointer-events: none;
    /* keep the face clear: rain lives on the outer thirds */
    -webkit-mask-image: linear-gradient(90deg, #000 0, #000 24%, transparent 44%, transparent 56%, #000 76%, #000 100%);
            mask-image: linear-gradient(90deg, #000 0, #000 24%, transparent 44%, transparent 56%, #000 76%, #000 100%);
  }
  .rain__tag {
    position: absolute; z-index: 5; top: clamp(5rem, 12vh, 7rem); right: var(--pad);
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--accent); opacity: 0.95; box-shadow: 0 0 16px color-mix(in oklab, var(--accent) 35%, transparent);
    border: 1px solid color-mix(in oklab, currentColor 40%, transparent);
    padding: 0.2rem 0.55rem; border-radius: 999px;
    background: color-mix(in oklab, var(--bg) 60%, transparent);
  }
  .rain__tag[data-mode="arm"] {
    background-image: linear-gradient(90deg, #ff5f6d, #ffc371, #4af0a2, #4aa8ff, #c04aff);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  @media (max-width: 640px) { .rain__tag { display: none; } }
</style>
