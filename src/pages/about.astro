---
import Page from '../layouts/Page.astro';
import Collab from '../components/Collab.astro';
import { GALLERY } from '../data/gallery';

const CERTS = [
  { name: 'GCFA', note: 'GIAC Certified Forensic Analyst', badge: '/giac-certified-forensic-analyst-gcfa.png' },
  { name: 'BTL1', note: 'Blue Team Level 1', badge: '/btl1.png' },
  { name: 'Security+', note: 'CompTIA Security+', badge: '/security-plus.png' },
];

const CVES = [
  { id: 'CVE-2025-50861', title: 'Exported deep-link activity', text: 'Lotus Cars Android app 1.2.8: PushDeepLinkActivity is exported and reachable without authentication via ADB or a malicious app, risking denial of service or logic abuse.' },
  { id: 'CVE-2025-50862', title: 'ADB backup data exposure', text: 'Lotus Cars Android app 1.2.8: allowBackup=true in the manifest allows user data to be pulled over ADB backup on rooted or debug-enabled devices.' },
];

const TOOLS = [
  { t: 'Hayabusa Lens', d: 'A dashboard for Hayabusa and Chainsaw with a 3D attack map and an AI investigator that keeps an audit trail of every question it asks.', install: 'pipx install hayabusa-lens', pypi: 'https://pypi.org/project/hayabusa-lens/', repo: 'https://github.com/JackSessions/hayabusa-lens', post: '/blog/hayabusa-lens-from-evtx-to-an-attack-story/' },
  { t: 'PhantomTrace', d: 'A read-only NTFS checker that compares the MFT, cluster bitmap and run lists and flags where they disagree, a possible sign of tampering.', install: 'pipx install phantom-trace-ntfs', pypi: 'https://pypi.org/project/phantom-trace-ntfs/', repo: 'https://github.com/JackSessions/PhantomTrace', post: '/blog/phantomtrace-checking-whether-ntfs-agrees-with-itself/' },
  { t: 'manifest-trace', d: 'Batch-scans Android APK manifests for exposed components, backup flags, debuggable flags, and cleartext traffic issues. Fast triage for mobile pentesters.', install: 'pip install manifest-trace', pypi: 'https://pypi.org/project/manifest-trace/', repo: 'https://github.com/JackSessions/manifest-trace', post: null },
  { t: 'runtime-trace', d: 'Linux runtime consistency checker using eBPF to detect process and module hiding and fileless execution. Built for DFIR and blue teams.', install: 'pip install runtime-trace', pypi: 'https://pypi.org/project/runtime-trace/', repo: 'https://github.com/JackSessions/runtime-trace', post: null },
];

const STACK = [
  { cat: 'Languages', items: ['Python', 'Kotlin', 'Java', 'Bash', 'C', 'TypeScript'] },
  { cat: 'Mobile & RE', items: ['Frida', 'jadx', 'apktool', 'objection', 'ADB', 'MobSF', 'Ghidra', 'IDA Free'] },
  { cat: 'DFIR & Forensics', items: ['Volatility 3', 'Hayabusa', 'Chainsaw', 'KAPE', 'Autopsy', 'Velociraptor', 'FTK Imager', 'Cellebrite'] },
  { cat: 'Offensive & Research', items: ['Burp Suite Pro', 'Metasploit', 'Nmap', 'Wireshark', 'CyberChef', 'Nuclei'] },
  { cat: 'Cloud & Infra', items: ['Docker', 'GitHub Actions', 'Cloudflare Workers', 'Linux', 'Wazuh', 'Splunk'] },
];

const FOCUS = [
  { t: 'Mobile security', d: 'Android APK analysis, iOS bootchain and Secure Enclave research, and runtime instrumentation.', link: '/talks' },
  { t: 'Anti-forensics & counterintelligence', d: 'How devices and people hide, spoof and mislead, and how investigators see through it.', link: '/talks' },
  { t: 'DFIR', d: 'Memory, disk and telemetry forensics, including how game cheats leave footprints.', link: '/talks' },
  { t: 'Crypto investigations', d: 'Tracing funds and building evidence trails for cases that cross borders.', link: '/videos' },
];
---

<Page title="About" description="About Jack Sessions: security researcher in mobile security, DFIR and counterintelligence.">
  <section class="section">
    <div class="wrap about">
      <div class="section-head">
        <h2>About</h2><span class="rule"></span>
      </div>

      <div class="intro">
        <img class="intro__photo" src="/speaking.jpg" alt="Jack Sessions presenting on stage" width="400" height="225" />
        <div>
          <p class="bio">
            I'm Jack Sessions, a security researcher working in mobile security, digital forensics and
            incident response, and vulnerability research. I'm a current Computer Science student at UNSW,
            and I rap in my spare time.
          </p>
          <p class="tads" data-type aria-label="Bio">
            Security Researcher (Mobile). Bounty hunter for the US Diplomatic Security Service, helping
            12 countries' security services find and track cyber criminals. Contributes to many open source
            projects with a focus on mobile security and AppSec. Works on phone and device security,
            particularly anti-forensics and counter intelligence.
          </p>
        </div>
      </div>

      <h3>What I work on</h3>
      <div class="grid grid--2 focus">
        {FOCUS.map((f) => (
          <a class="card" href={f.link}>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </a>
        ))}
      </div>

      <h3>Published tools</h3>
      <p class="muted more" style="margin-top:0">Four open-source security tools on PyPI. <a href="https://pypi.org/user/Jack_Sessions/" target="_blank" rel="noopener">All packages ↗</a></p>
      <div class="grid grid--2 focus">
        {TOOLS.map((t) => (
          <div class="card">
            <span class="meta">on PyPI</span>
            <h3>{t.post ? <a href={t.post}>{t.t}</a> : t.t}</h3>
            <p>{t.d}</p>
            <code class="install">{t.install}</code>
            <div class="tags">
              {t.post && <a class="tag link" href={t.post}>write-up</a>}
              <a class="tag link" href={t.repo} target="_blank" rel="noopener">GitHub ↗</a>
              <a class="tag link" href={t.pypi} target="_blank" rel="noopener">PyPI ↗</a>
            </div>
          </div>
        ))}
      </div>

      <h3>Tech stack</h3>
      <div class="stack">
        {STACK.map((s) => (
          <div class="stack__row">
            <span class="stack__cat">{s.cat}</span>
            <div class="stack__chips">
              {s.items.map((i) => <span class="chip">{i}</span>)}
            </div>
          </div>
        ))}
      </div>

      <h3>Research &amp; recognition</h3>
      <div class="cves">
        {CVES.map((c) => (
          <a class="cve" href={`https://nvd.nist.gov/vuln/detail/${c.id}`} target="_blank" rel="noopener">
            <span class="mono cve__id">{c.id}</span>
            <strong>{c.title}</strong>
            <span class="cve__text">{c.text}</span>
          </a>
        ))}
      </div>
      <p class="muted more">More research is presented on the <a href="/talks">talks</a> page, with slides for most sessions.</p>

      <h3>Photo reel</h3>
      <div class="reel" tabindex="0" aria-label="Photo reel">
        {GALLERY.map((g) => (
          <figure>
            <img src={g.src} alt={g.alt} loading="lazy" />
            {g.caption && <figcaption>{g.caption}</figcaption>}
          </figure>
        ))}
      </div>

      <h3>Off the clock</h3>
      <div class="grid grid--2 focus" style="margin-bottom:0.5rem">
        <div class="card">
          <h3>🎵 Soundtrack for deep work</h3>
          <p>Jeremy Soule's Oblivion and Skyrim OSTs are basically a second brain. Auriel's Ascension for architecture decisions, Call of Magic for late-night reversing sessions. Criminally underrated focus fuel.</p>
        </div>
        <div class="card">
          <h3>🐱 Cat volunteering</h3>
          <p>I volunteer at a local cat shelter on weekends. Turns out socialising rescue cats and debugging kernel panics require the same energy: patience, snacks, and refusing to give up.</p>
        </div>
        <div class="card">
          <h3>🎤 Rap & music production</h3>
          <p>I write and record my own tracks. Security researcher by day, emcee by night. There's more overlap than you'd think — both involve pattern recognition and knowing when to go hard.</p>
        </div>
        <div class="card">
          <h3>✈️ Conference travel</h3>
          <p>BSides Tokyo, SinCon Singapore, AVTOKYO — half security research, half excuse to eat good food and find the best local coffee. Currently chasing talks on five continents.</p>
        </div>
      </div>

      <h3>Certifications</h3>
      <ul class="certs">
        {CERTS.map((c) => (
          <li>
            <img src={c.badge} alt="" width="84" height="84" />
            <span><strong>{c.name}</strong><br /><span class="muted">{c.note}</span></span>
          </li>
        ))}
      </ul>
      <p class="muted more">Working toward GEIR. Verify on <a href="https://www.credly.com/users/jack_sessions" target="_blank" rel="noopener">Credly</a>.</p>

      <h3>Education</h3>
      <p>UNSW, Bachelor of Computer Science <span class="muted">(expected 2028)</span></p>

      <Collab />
    </div>
  </section>
</Page>

<script>
  // Typewriter: types each bio line, holds, deletes, moves on.
  const el = document.querySelector<HTMLElement>('[data-type]');
  const LINES = [
    'Security Researcher — mobile, DFIR, vulnerability research.',
    "Bug bounty hunter for the US Diplomatic Security Service across 12 countries.",
    'Four tools on PyPI. 20+ responsible disclosures. 4 patents.',
    'Specialises in Android/iOS forensics, anti-forensics and counterintelligence.',
    'Computer Science @ UNSW. Currently breaking things so banks don\'t have to.',
  ];
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let li = 0, ci = 0, del = false;
    el.textContent = '';
    const step = () => {
      const line = LINES[li];
      ci += del ? -3 : 1;
      el.textContent = line.slice(0, Math.max(0, ci));
      let delay = del ? 14 : 30 + Math.random() * 35;
      if (!del && ci >= line.length) { del = true; delay = 2800; }
      else if (del && ci <= 0) { del = false; li = (li + 1) % LINES.length; delay = 450; }
      setTimeout(step, delay);
    };
    step();
  }
</script>

<style>
  .about { max-width: 58rem; }
  h3 { margin: 2.5rem 0 0.9rem; }
  .intro { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 48rem) { .intro { grid-template-columns: 20rem 1fr; } }
  .intro__photo { width: 100%; height: auto; border-radius: var(--radius); border: 1px solid var(--line); }
  .bio { margin: 0 0 1rem; max-width: none; }
  .tads { margin: 0; padding-left: 1rem; border-left: 2px solid var(--accent); color: var(--muted); max-width: 62ch; min-height: 6.5em; font-family: var(--font-mono); font-size: 0.92rem; }
  .tads::after { content: '▌'; margin-left: 2px; color: var(--accent); animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .focus .card h3 { margin: 0; font-size: 1.05rem; }
  .cves { display: grid; gap: 0.75rem; }
  .cve { display: grid; gap: 0.25rem; padding: 1rem 1.1rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); color: inherit; text-decoration: none; }
  .cve:hover { border-color: var(--accent); }
  .cve__id { color: var(--accent); font-size: 0.8rem; }
  .cve__text { color: var(--muted); font-size: 0.92rem; }
  .more { margin-top: 0.8rem; max-width: none; }
  .reel { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 0.6rem; align-items: flex-start; }
  .reel figure { margin: 0; flex: 0 0 min(85%, 24rem); scroll-snap-align: start; }
  .reel img { width: 100%; height: auto; border-radius: var(--radius); border: 1px solid var(--line); display: block; }
  .reel figcaption { margin-top: 0.4rem; color: var(--muted); font-size: 0.85rem; }
  .certs { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1.5rem 2.5rem; }
  .certs li { display: flex; align-items: center; gap: 0.9rem; }
  .certs img { object-fit: contain; }
  .stack { display: grid; gap: 0.65rem; }
  .stack__row { display: grid; grid-template-columns: 10rem 1fr; gap: 0.75rem; align-items: start; padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  @media (max-width: 40rem) { .stack__row { grid-template-columns: 1fr; gap: 0.3rem; } }
  .stack__cat { font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent); text-transform: uppercase; letter-spacing: .08em; padding-top: 0.2rem; }
  .stack__chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .chip { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 0.2rem 0.6rem; font-size: 0.82rem; color: var(--muted); }
</style>
