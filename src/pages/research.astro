---
import Page from '../layouts/Page.astro';
import Collab from '../components/Collab.astro';

const DISCLOSURES = [
  {
    org: 'Singpass',
    logo: null,
    country: 'Singapore · Gov',
    id: 'Responsible disclosure',
    title: 'Authentication vulnerability in Singpass mobile application',
    text: 'Identified a vulnerability in Singapore\'s national digital identity platform, used by ~4 million citizens. Reported to the Cyber Security Agency of Singapore (CSA) through responsible disclosure. Acknowledged and patched.',
    severity: 'High',
    status: 'Patched',
    tags: ['Mobile', 'Authentication', 'Android/iOS'],
    post: '/blog/singpass-deep-link-disclosure/',
    evidence: {
      type: 'multi',
      caption: 'Frida trace script and logcat confirming unvalidated deep link URI on sg.ndi.sp v26.1.1.',
      blocks: [
        {
          label: 'frida-trace.js',
          lang: 'javascript',
          code: `Java.perform(function() {
  var DeepLinkActivity = Java.use("sg.ndi.activity.DeepLinkDashBoardActivity");

  DeepLinkActivity.onNewIntent.implementation = function(intent) {
    console.log("[VDP-TRACE] DeepLinkDashBoardActivity received a new Intent!");

    if (intent !== null) {
      var dataUri = intent.getData();
      if (dataUri !== null) {
        console.log("[VDP-TRACE] UNTRUSTED INPUT DETECTED: " + dataUri.toString());
        console.log("[VDP-TRACE] WARNING: This string is being passed to internal " +
                    "components without validation.");
      }
    }
    this.onNewIntent(intent);
  };
});`,
        },
        {
          label: 'logcat — dex2oat confirming target binary',
          lang: 'text',
          code: `08-05 19:53:23.700  F DEBUG   : Cmdline: /apex/com.android.art/bin/dex2oat32
  --zip-location=.../sg.ndi.sp-w5miu1jf_g6hQR2y2xwZyg==/base.apk
  --comments=app-name:sg.ndi.sp,app-version-name:26.1.1,app-version-code:200
  ...
[VDP-TRACE] DeepLinkDashBoardActivity received a new Intent!
[VDP-TRACE] UNTRUSTED INPUT DETECTED: singpass://dashboard?redirect=...
[VDP-TRACE] WARNING: This string is being passed to internal components without validation.`,
        },
      ],
    },
  },
  {
    org: 'Boeing',
    logo: null,
    country: 'USA · Aerospace & Defence',
    id: 'Responsible disclosure · DO-326A/ED-12C',
    title: 'Boeing 787 cabin network segmentation failure: HP ProCurve, Scoot Airlines TR11/TR14',
    text: 'Confirmed network segmentation failure on two Scoot Airlines 787 flights (TR11 SYD→SIN and TR14 SIN→SYD, June 2026): ICMP echo requests from the passenger WiFi received replies from internal aircraft IP addresses, violating DO-326A/ED-12C airworthiness security isolation requirements. HP ProCurve hardware confirmed via WiGLE passive scanning (BSSIDs 00:24:a8:xx:xx:xx). Theoretical attack surface includes lateral movement to operational networks (est. CVSS 9.5) and cross-domain protocol injection into ARINC 429/AFDX (est. CVSS 10.0). No exploitation attempted. Disclosed to Boeing PSIRT, FAA, CAAS Singapore, SingCERT, CERT/CC and ASD.',
    severity: 'High',
    status: 'Acknowledged',
    tags: ['Aviation', 'Network', 'DO-326A', 'HP ProCurve'],
    post: '/blog/boeing-787-cabin-network-segmentation-failure/',
    evidence: {
      type: 'images',
      caption: 'WiGLE passive WiFi scans confirming HP ProCurve hardware on both flights, June 2026.',
      images: [
        { src: '/research/wigle-tr11-syd-sin.jpg', alt: 'WiGLE scan showing ScootWiFi SSIDs backed by ProCurve Networking by HP on TR11 SYD to SIN', caption: 'TR11 SYD→SIN · 23 June 2026 · BSSIDs 00:24:a8:85:8d range' },
        { src: '/research/wigle-tr14-sin-syd.jpg', alt: 'WiGLE scan showing Scoot_WiFi SSIDs backed by Hewlett Packard hardware on TR14 SIN to SYD', caption: 'TR14 SIN→SYD · 30 June 2026 · Hewlett Packard + ProCurve confirmed' },
      ],
    },
  },
  {
    org: 'GrapheneOS',
    logo: null,
    country: 'Open Source · Android Security',
    id: 'Security advisory',
    title: 'Security research into GrapheneOS hardening surface',
    text: 'Research into the security model and hardening surface of GrapheneOS, a privacy and security-focused Android distribution. Findings reported to the GrapheneOS security team.',
    severity: 'Medium',
    status: 'Disclosed',
    tags: ['Android', 'AOSP', 'Mobile'],
    evidence: {
      type: 'text',
      caption: 'Research scope and methodology.',
      body: 'Analysis focused on the GrapheneOS hardening surface: SELinux policy gaps, app sandbox escape vectors, and permission model edge cases specific to the GrapheneOS fork versus AOSP. Research conducted on a Pixel device running GrapheneOS. Findings reported directly to the GrapheneOS security team via their published disclosure channel. Technical details withheld pending full remediation confirmation.',
    },
  },
  {
    org: 'Lotus Cars',
    logo: null,
    country: 'UK · Automotive',
    id: 'CVE-2025-50861',
    title: 'Exported deep-link activity: Lotus Android app 1.2.8',
    text: 'PushDeepLinkActivity is exported and reachable without authentication via ADB or a malicious app, risking denial of service or logic abuse.',
    severity: 'Medium',
    status: 'Patched',
    tags: ['Android', 'CVE', 'Automotive'],
    nvd: 'https://nvd.nist.gov/vuln/detail/CVE-2025-50861',
    evidence: {
      type: 'code',
      caption: 'Vulnerable manifest entry — PushDeepLinkActivity exported with no permission gate.',
      lang: 'xml',
      code: `<!-- AndroidManifest.xml — Lotus app 1.2.8 -->
<activity
  android:name="com.lotus.app.PushDeepLinkActivity"
  android:exported="true" />
<!-- No android:permission attribute. Any caller, any URI. -->`,
    },
  },
  {
    org: 'Lotus Cars',
    logo: null,
    country: 'UK · Automotive',
    id: 'CVE-2025-50862',
    title: 'ADB backup data exposure: Lotus Android app 1.2.8',
    text: 'allowBackup=true in the manifest allows full user data to be extracted over ADB backup on rooted or debug-enabled devices.',
    severity: 'Medium',
    status: 'Patched',
    tags: ['Android', 'CVE', 'Automotive'],
    nvd: 'https://nvd.nist.gov/vuln/detail/CVE-2025-50862',
    evidence: {
      type: 'code',
      caption: 'Vulnerable manifest entry — allowBackup not disabled.',
      lang: 'xml',
      code: `<!-- AndroidManifest.xml — Lotus app 1.2.8 -->
<application
  android:allowBackup="true"
  ... >
<!-- Full app data extractable via: adb backup -apk -nosystem com.lotus.app -->`,
    },
  },
];

const OTHER_RESEARCH = [
  {
    area: 'EMP & Flashbang Countermeasures',
    domain: 'Hardware Security · Electronic Warfare',
    text: 'Research into EMP-generating devices, hardening techniques for embedded systems against electromagnetic pulse attack, and the intersection of physical disruption tools with digital forensics and electronic evidence.',
    tags: ['EMP', 'Hardware', 'Electronic Warfare', 'Anti-Forensics'],
    status: 'Ongoing',
    detail: 'Focus areas: EMP pulse characteristics and shielding thresholds for embedded systems (Faraday cage construction, TVS diode placement, ferrite core selection); how flash-bang and EMP devices interact with digital evidence preservation in first-responder and DFIR contexts; and whether physical disruption events leave artefacts recoverable under NIST SP 800-101 mobile forensic guidelines. Write-up in progress.',
  },
  {
    area: 'SIGINT Drone Technology',
    domain: 'UAV · Signals Intelligence',
    text: 'UAV-mounted signals intelligence: passive RF collection, spectrum analysis from airborne platforms, and the security posture of civilian drone communication links (MAVLink, DJI OcuSync, custom RF stacks).',
    tags: ['UAV', 'SIGINT', 'RF Security', 'Drones'],
    status: 'Ongoing',
    detail: 'Active work: passive spectrum capture from a small UAV platform (SDR + Raspberry Pi); analysis of MAVLink v2 authentication gaps (unauthenticated heartbeat injection); and DJI OcuSync 2.0 link characterisation. Secondary angle: SIGINT drone detection — what RF signatures a passive collector leaves, and whether standard IDS tooling (Kismet, rtl_433) catches it at range. Write-up in progress.',
  },
  {
    area: 'Anti-Forensics Dead Man Switch',
    domain: 'Anti-Forensics · Operational Security',
    text: 'Design and analysis of hardware and software dead man switch systems intended to trigger data destruction or encryption on device seizure. Research covers both implementation (for understanding defensive use cases) and forensic bypass techniques.',
    tags: ['Anti-Forensics', 'DFIR', 'Hardware', 'OpSec'],
    status: 'Ongoing',
    detail: 'Research covers three implementation classes: (1) USB kill-switch dongles that trigger LUKS key wipe on removal; (2) network heartbeat systems that encrypt or destroy data if a keepalive beacon stops; (3) hardware tamper sensors (accelerometer/light sensor triggered). Forensic bypass research focuses on imaging before the switch fires — power analysis, cold-boot attacks, and write-blocker strategies. Both offensive and defensive analysis; no exploitation of live systems.',
  },
  {
    area: 'IoT Security: Smart Fridge',
    domain: 'IoT · Embedded · Consumer Devices',
    text: 'Vulnerability research on networked consumer appliances: attack surface mapping, firmware extraction, exposed network services, and weak authentication patterns in smart home devices.',
    tags: ['IoT', 'Embedded', 'Firmware', 'Consumer'],
    status: 'Ongoing',
    detail: 'Target: a networked smart fridge with a companion Android app and cloud API. Attack surface: firmware (binwalk extraction, hardcoded credentials check), exposed local network services (nmap, Shodan for similar models), companion app (manifest-trace, Frida), and cloud API (Burp, auth token analysis). Goal: a full attack chain from LAN access to account takeover or data exposure. Vendor notified if anything material is found before publication.',
  },
  {
    area: 'Sony PSP Exploitation',
    domain: 'Retro Hardware · Embedded Exploitation',
    text: 'Exploitation research on the Sony PlayStation Portable: bootloader vulnerabilities, custom firmware analysis, Memory Stick attack surfaces, and using retro hardware as a platform for learning kernel-level exploitation primitives.',
    tags: ['PSP', 'Embedded', 'Retro', 'Kernel'],
    status: 'Ongoing',
    detail: 'The PSP is a contained MIPS platform with well-documented but historically under-explained exploits. Research goals: reproduce the original HEN/CFW exploit chains from first principles (no patched binaries), understand the Memory Stick format parser attack surface, and use the PSP as a clean environment for practising kernel heap and stack exploitation without the noise of modern mitigations (ASLR, NX, CFI). Write-up aimed at other researchers wanting a hardware exploitation primer.',
  },
];

const SEVERITY_COLOR: Record<string, string> = {
  Critical: '#f38ba8',
  High:     '#fab387',
  Medium:   '#f9e2af',
  Low:      '#a6e3a1',
};
---

<Page title="Research" description="Vulnerability research and responsible disclosures by Jack Sessions — Singpass, Boeing, GrapheneOS and more.">
  <section class="section">
    <div class="wrap research">
      <div class="section-head">
        <h2>Research</h2><span class="rule"></span>
        <span class="count">responsible disclosure</span>
      </div>

      <div class="stats-row">
        <div class="stat"><span class="stat__n">20+</span><span class="stat__l">Responsible disclosures</span></div>
        <div class="stat"><span class="stat__n">4</span><span class="stat__l">CVEs assigned</span></div>
        <div class="stat"><span class="stat__n">4</span><span class="stat__l">Tools on PyPI</span></div>
        <div class="stat"><span class="stat__n">10+</span><span class="stat__l">Conferences spoken at</span></div>
      </div>

      <p class="lead">
        Security vulnerabilities found and responsibly disclosed. All findings were reported to
        the relevant vendor or programme before publication, following coordinated disclosure best practice.
      </p>

      <div class="disc-grid">
        {DISCLOSURES.map((d) => (
          <div class="disc">
            <div class="disc__head">
              <div>
                <span class="disc__org">{d.org}</span>
                <span class="disc__country">{d.country}</span>
              </div>
              <div class="disc__badges">
                <span class="badge" style={`color:${SEVERITY_COLOR[d.severity] ?? 'var(--muted)'}`}>{d.severity}</span>
                <span class="badge badge--status">{d.status}</span>
              </div>
            </div>
            <span class="disc__id mono">{d.id}</span>
            <strong class="disc__title">{d.title}</strong>
            <p class="disc__text">{d.text}</p>
            <div class="tags">
              {d.tags.map((t) => <span class="tag">{t}</span>)}
              {d.nvd && <a class="tag link" href={d.nvd} target="_blank" rel="noopener">NVD ↗</a>}
              {d.org === 'Boeing' && <a class="tag link" href="/blog/boeing-787-cabin-network-segmentation-failure/">Write-up ↗</a>}
            </div>
            {d.evidence && (() => {
              const ev = d.evidence as any;
              return (
                <details class="disc__evidence">
                  <summary class="disc__evidence-toggle">View evidence</summary>
                  <div class="disc__evidence-body">
                    <p class="disc__evidence-caption">{ev.caption}</p>
                    {ev.type === 'images' && (
                      <div class="disc__evidence-grid">
                        {ev.images.map((img: any) => (
                          <figure class="evidence-fig">
                            <img src={img.src} alt={img.alt} loading="lazy" />
                            <figcaption>{img.caption}</figcaption>
                          </figure>
                        ))}
                      </div>
                    )}
                    {ev.type === 'code' && (
                      <pre class="disc__evidence-code"><code>{ev.code}</code></pre>
                    )}
                    {ev.type === 'multi' && ev.blocks.map((b: any) => (
                      <div class="disc__evidence-block">
                        <span class="disc__evidence-label">{b.label}</span>
                        <pre class="disc__evidence-code"><code>{b.code}</code></pre>
                      </div>
                    ))}
                    {ev.type === 'text' && (
                      <p class="disc__evidence-body-text">{ev.body}</p>
                    )}
                  </div>
                </details>
              );
            })()}
            {d.post && !d.evidence && (
              <div class="disc__evidence" style="border-top:1px solid var(--line);padding-top:0.5rem;margin-top:0.5rem">
                <a class="disc__evidence-toggle" style="color:var(--accent);font-family:var(--font-mono);font-size:0.75rem" href={d.post}>Read write-up →</a>
              </div>
            )}
          </div>
        ))}
      </div>

      <div class="testimonials">
        <blockquote class="testimonial">
          <p>"After everything there was the after party where I was able to meet and chat with some super sick people especially <strong>Jack Sessions</strong> (he pwned Singpass btw). Bro is literally the embodiment of 'living on the edge' whilst being the sickest person ever."</p>
          <cite>Koh Tom Han, Wannabe Vulnerability Researcher · SinCon 2026</cite>
        </blockquote>
        <blockquote class="testimonial">
          <p>"What an asset to have on any ticket! Nice work CeylonCon!"</p>
          <cite>Victor Hanna, Director &amp; Chief Hacking Officer · Exploit Security · on the CeylonCon Ambassador announcement</cite>
        </blockquote>
      </div>

      <div class="section-head" style="margin-top:3rem">
        <h2>Ambassador</h2><span class="rule"></span>
      </div>
      <div class="ambassador-card">
        <div class="ambassador-card__badges">
          <span class="amb-badge">Speaker</span>
          <span class="amb-badge">Researcher</span>
          <span class="amb-badge">GCFA</span>
        </div>
        <div class="ambassador-card__body">
          <span class="ambassador-card__org">CeylonCon Ambassador Programme</span>
          <h3 class="ambassador-card__name">Jack Sessions</h3>
          <p class="ambassador-card__role">DFIR, UAV &amp; Mobile Security Researcher · Australia</p>
          <blockquote class="ambassador-card__quote">
            "Integrity and character are the only metrics that outlast every other measure of success in cybersecurity."
          </blockquote>
          <p class="ambassador-card__bio">
            CeylonCon is Sri Lanka's annual community-driven technology conference, run by the Ceylon Computer Foundation. Jack was announced as the Australian ambassador: representing the CeylonCon community across Australia and the Sri Lankan diaspora, and connecting the security research communities of both countries.
          </p>
          <div class="tags" style="margin-top:0.75rem">
            <span class="tag">CeylonCon</span>
            <span class="tag">Sri Lanka</span>
            <span class="tag">Australia</span>
            <a class="tag link" href="https://ceyloncon.com" target="_blank" rel="noopener">ceyloncon.com ↗</a>
          </div>
        </div>
      </div>

      <div class="section-head" style="margin-top:3rem">
        <h2>Tools</h2><span class="rule"></span>
      </div>
      <p class="lead">Four open-source security tools on PyPI. <a href="https://pypi.org/user/Jack_Sessions/" target="_blank" rel="noopener">See all on PyPI ↗</a></p>
      <div class="tool-list">
        <a class="tool" href="/blog/hayabusa-lens-from-evtx-to-an-attack-story/">
          <span class="tool__name">Hayabusa Lens</span>
          <span class="tool__desc">EVTX dashboard with 3D attack map and AI investigator</span>
          <code class="tool__install">pipx install hayabusa-lens</code>
        </a>
        <a class="tool" href="/blog/phantomtrace-checking-whether-ntfs-agrees-with-itself/">
          <span class="tool__name">PhantomTrace</span>
          <span class="tool__desc">Read-only NTFS integrity checker: MFT vs cluster bitmap vs run lists</span>
          <code class="tool__install">pipx install phantom-trace-ntfs</code>
        </a>
        <a class="tool" href="https://pypi.org/project/manifest-trace/" target="_blank" rel="noopener">
          <span class="tool__name">manifest-trace</span>
          <span class="tool__desc">Batch-scans Android APKs for exposed components, backup flags, cleartext issues</span>
          <code class="tool__install">pip install manifest-trace</code>
        </a>
        <a class="tool" href="https://pypi.org/project/runtime-trace/" target="_blank" rel="noopener">
          <span class="tool__name">runtime-trace</span>
          <span class="tool__desc">eBPF-based Linux runtime checker for process hiding and fileless execution</span>
          <code class="tool__install">pip install runtime-trace</code>
        </a>
      </div>

      <div class="section-head" style="margin-top:3rem">
        <h2>Other Research</h2><span class="rule"></span>
      </div>
      <p class="lead">Ongoing and forthcoming research areas. Write-ups in progress.</p>
      <div class="other-grid">
        {OTHER_RESEARCH.map((r) => (
          <div class="other-card">
            <div class="other-card__head">
              <strong class="other-card__area">{r.area}</strong>
              <span class="badge badge--status">{r.status}</span>
            </div>
            <span class="other-card__domain mono">{r.domain}</span>
            <p class="disc__text">{r.text}</p>
            <div class="tags">{r.tags.map((t) => <span class="tag">{t}</span>)}</div>
            {r.detail && (
              <details class="disc__evidence">
                <summary class="disc__evidence-toggle">More detail</summary>
                <div class="disc__evidence-body">
                  <p class="disc__evidence-body-text">{r.detail}</p>
                </div>
              </details>
            )}
          </div>
        ))}
      </div>

      <div class="section-head" style="margin-top:3rem">
        <h2>Talks</h2><span class="rule"></span>
      </div>
      <p class="lead">Research presented at BSides Tokyo, BSides Canberra, SinCon Singapore, AVTOKYO and more. <a href="/talks">Full list →</a></p>

      <Collab />
    </div>
  </section>
</Page>

<style>
  .research { max-width: 58rem; }
  .lead { color: var(--muted); max-width: 64ch; margin: 0 0 1.5rem; }
  .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 0 0 2rem; }
  @media (max-width: 40rem) { .stats-row { grid-template-columns: repeat(2, 1fr); } }
  .stat { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem; display: grid; gap: 0.2rem; }
  .stat__n { font-size: 2rem; font-weight: 800; color: var(--accent); line-height: 1; }
  .stat__l { font-size: 0.78rem; color: var(--muted); }
  .testimonial { border-left: 3px solid var(--accent); margin: 2rem 0; padding: 1rem 1.25rem; background: var(--surface); border-radius: 0 var(--radius) var(--radius) 0; }
  .testimonial p { margin: 0 0 0.5rem; font-size: 0.95rem; line-height: 1.7; color: var(--muted); }
  .testimonial cite { font-size: 0.8rem; color: var(--accent); font-style: normal; font-family: var(--font-mono); }
  .disc-grid { display: grid; gap: 1rem; }
  .disc { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.25rem; display: grid; gap: 0.35rem; }
  .disc:hover { border-color: var(--accent); }
  .disc__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
  .disc__org { font-weight: 700; font-size: 1rem; }
  .disc__country { display: block; font-size: 0.78rem; color: var(--muted); margin-top: 0.15rem; }
  .disc__badges { display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center; }
  .badge { font-family: var(--font-mono); font-size: 0.72rem; padding: 0.15rem 0.5rem; border-radius: 4px; border: 1px solid currentColor; }
  .badge--status { color: var(--muted); border-color: var(--line); }
  .disc__id { font-size: 0.75rem; color: var(--accent); }
  .disc__title { font-size: 0.97rem; }
  .disc__text { color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0; }
  .testimonials { display: grid; gap: 1rem; }
  @media (min-width: 52rem) { .testimonials { grid-template-columns: 1fr 1fr; } }
  .ambassador-card { background: var(--surface); border: 1px solid var(--accent); border-radius: var(--radius); padding: 1.5rem 1.75rem; display: grid; gap: 0.75rem; }
  .ambassador-card__badges { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .amb-badge { font-family: var(--font-mono); font-size: 0.72rem; padding: 0.15rem 0.55rem; border-radius: 4px; border: 1px solid var(--accent); color: var(--accent); }
  .ambassador-card__org { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .ambassador-card__name { margin: 0; font-size: 1.6rem; letter-spacing: .04em; }
  .ambassador-card__role { color: var(--muted); font-size: 0.9rem; margin: 0; }
  .ambassador-card__quote { border-left: 3px solid var(--accent); margin: 0.5rem 0; padding: 0.5rem 1rem; color: var(--muted); font-style: italic; font-size: 0.95rem; }
  .ambassador-card__bio { color: var(--muted); font-size: 0.88rem; line-height: 1.65; margin: 0; }
  .disc__evidence { margin-top: 0.5rem; border-top: 1px solid var(--line); padding-top: 0.5rem; }
  .disc__evidence-toggle { cursor: pointer; font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); list-style: none; display: inline-flex; align-items: center; gap: 0.4rem; user-select: none; }
  .disc__evidence-toggle::-webkit-details-marker { display: none; }
  .disc__evidence-toggle::before { content: '▶'; font-size: 0.6rem; transition: transform 0.15s; }
  details[open] .disc__evidence-toggle::before { transform: rotate(90deg); }
  .disc__evidence-body { margin-top: 0.75rem; }
  .disc__evidence-caption { font-size: 0.82rem; color: var(--muted); margin: 0 0 0.75rem; }
  .disc__evidence-grid { display: grid; gap: 0.75rem; }
  @media (min-width: 44rem) { .disc__evidence-grid { grid-template-columns: 1fr 1fr; } }
  .evidence-fig { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .evidence-fig img { width: 100%; display: block; border-bottom: 1px solid var(--line); }
  .evidence-fig figcaption { padding: 0.5rem 0.75rem; font-size: 0.8rem; color: var(--muted); font-family: var(--font-mono); }
  .disc__evidence-block { display: grid; gap: 0.3rem; margin-bottom: 0.75rem; }
  .disc__evidence-block:last-child { margin-bottom: 0; }
  .disc__evidence-label { font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); }
  .disc__evidence-code { background: #0d1117; border: 1px solid var(--line); border-radius: var(--radius); padding: 0.9rem 1rem; overflow-x: auto; font-size: 0.78rem; line-height: 1.6; color: #e6edf3; font-family: var(--font-mono); white-space: pre; margin: 0; }
  .disc__evidence-body-text { font-size: 0.85rem; color: var(--muted); line-height: 1.65; margin: 0; }
  .other-grid { display: grid; gap: 0.75rem; margin-bottom: 0.5rem; }
  @media (min-width: 52rem) { .other-grid { grid-template-columns: 1fr 1fr; } }
  .other-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.2rem; display: grid; gap: 0.3rem; }
  .other-card:hover { border-color: var(--accent); }
