---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';

const projects = (await getCollection('projects')).sort((a, b) => {
  const f = Number(b.data.featured) - Number(a.data.featured);
  if (f !== 0) return f;
  return (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0);
});

// Structured data so Google can read each project as a real piece of software, linked to its GitHub
// repo and (where published) its PyPI package, authored by Jack Sessions.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: projects
    .filter((pr) => pr.data.repoUrl || pr.data.pypiUrl)
    .map((pr, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'SoftwareSourceCode',
        name: pr.data.title,
        description: pr.data.description,
        codeRepository: pr.data.repoUrl,
        url: pr.data.repoUrl,
        ...(pr.data.pypiUrl ? { downloadUrl: pr.data.pypiUrl } : {}),
        author: { '@type': 'Person', name: 'Jack Sessions', url: 'https://jacksessions.dev' },
        keywords: pr.data.tags.join(', '),
      },
    })),
};
---

<Page title="Projects" description="Open-source tooling, CVEs, and security research by Jack Sessions.">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Projects &amp; research</h2><span class="rule"></span>
        <span class="count">{projects.length} total</span>
      </div>

      {projects.length === 0 ? (
        <p class="muted">No projects yet. Add one at <code>src/content/projects/your-tool.md</code>.</p>
      ) : (
        <div class="grid grid--2">
          {projects.map((pr) => (
            <div class="card">
              <span class="meta">{pr.data.status}{pr.data.featured ? ' · featured' : ''}</span>
              <h3>{(pr.data.url || pr.data.repoUrl) ? <a href={pr.data.url || pr.data.repoUrl} target={(pr.data.url || pr.data.repoUrl).startsWith('http') ? '_blank' : undefined} rel="noopener">{pr.data.title}</a> : pr.data.title}</h3>
              <p>{pr.data.description}</p>
              {pr.data.install && <code class="install">{pr.data.install}</code>}
              <div class="tags">
                {pr.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                {pr.data.url && <a class="tag link" href={pr.data.url} target={pr.data.url.startsWith('http') ? '_blank' : undefined} rel="noopener">write-up</a>}
                {pr.data.repoUrl && <a class="tag link" href={pr.data.repoUrl} target="_blank" rel="noopener">GitHub ↗</a>}
                {pr.data.pypiUrl && <a class="tag link" href={pr.data.pypiUrl} target="_blank" rel="noopener">PyPI ↗</a>}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</Page>
