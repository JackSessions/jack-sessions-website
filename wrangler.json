{
	"name": "jack-sessions-website",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"routes": [
		{ "pattern": "jacksessions.dev/*", "zone_name": "jacksessions.dev" },
		{ "pattern": "www.jacksessions.dev/*", "zone_name": "jacksessions.dev" }
	]
}
